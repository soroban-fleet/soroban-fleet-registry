# Frontend Web Configuration (.env)
# Copy to .env.local for local Next.js development

# Public API URL for Soroban Fleet Registry backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Alternative environment variable alias accepted by web client
NEXT_PUBLIC_SFR_API_URL=http://localhost:8080

# Stellar network identifier displayed in UI badges
NEXT_PUBLIC_NETWORK=testnet

# Block explorer base URL for address/hash links (leave empty to disable links)
NEXT_PUBLIC_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
