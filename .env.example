# Backend Service Configuration (.env)
# Copy to .env for local or testnet deployments

# Target Stellar network: testnet | pubnet | futurenet | local
SFR_NETWORK=testnet

# Soroban RPC URL (Leave blank to use fixture/offline mode; required for live indexer/verification)
SFR_RPC_URL=https://soroban-testnet.stellar.org

# PostgreSQL connection string
SFR_DATABASE_URL=postgres://sfr:sfrpassword@localhost:5432/sfr?sslmode=disable

# HTTP API server listen address
SFR_HTTP_ADDR=:8080

# Logging level: debug | info | warn | error
SFR_LOG_LEVEL=info

# Optional ledger sequence to start indexing from
SFR_INDEXER_START_LEDGER=1000

# Batch size for RPC getLedgers calls
SFR_INDEXER_BATCH_SIZE=50

# Allowed CORS origins for frontend access (comma-separated, e.g. http://localhost:3000,https://fleet.example.com)
SFR_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Per-client API rate limits (token buckets). Set a rate to 0 to disable that category.
# Requests per second for ordinary read endpoints, with the initial burst capacity.
SFR_RATE_LIMIT_RPS=20
SFR_RATE_LIMIT_BURST=60
# Requests per second for RPC-intensive endpoints (fleet verify, contract inspect,
# indexer status), which fan out to live Stellar RPC and persist verification rows.
SFR_RATE_LIMIT_HEAVY_RPS=1
SFR_RATE_LIMIT_HEAVY_BURST=5

# Enable only when the API is reachable solely through a reverse proxy that sets
# X-Forwarded-For; otherwise clients could forge the header to escape their bucket.
SFR_TRUST_PROXY=false
